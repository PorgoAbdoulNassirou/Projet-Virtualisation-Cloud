# =============================================================================
# RÉSULTATS-BF — modèle de configuration (versionné)
# Le vrai fichier .env n'est JAMAIS versionné (voir .gitignore).
# Au premier « vagrant up », le Vagrantfile crée .env à partir de ce modèle et
# remplace chaque __ALEATOIRE__ par un mot de passe aléatoire.
# =============================================================================

# Numéro de groupe attribué par l'enseignant : groupe 04 → réseau 192.168.59.0/24
GROUPE=4

# Nombre de serveurs applicatifs (2 à 9). C'est LA valeur à changer pour R3.
NB_APP=2

# Extensions : 1 = machine créée, 0 = machine absente.
# Pendant le développement, mettez 0 pour économiser la mémoire.
E1_LB2=1
E2_OBS=1

# Port de l'hôte redirigé vers le port 80 de lb1
PORT_HOTE=8080

# --- Secrets (générés automatiquement) ---------------------------------------
PG_MDP_APP=__ALEATOIRE__
PG_MDP_REPLICATION=__ALEATOIRE__
# keepalived n'accepte que 8 caractères au maximum
VRRP_MDP=__ALEATOIRE8__
GRAFANA_MDP=__ALEATOIRE__
