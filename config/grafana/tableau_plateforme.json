{
  "uid": "resultats-bf",
  "title": "RÉSULTATS-BF — plateforme",
  "description": "Extension E2 : débit par serveur, état des serveurs vu par HAProxy, machines joignables, CPU. Provisionné par scripts/obs.sh.",
  "tags": ["resultats-bf", "E2"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Débit par serveur applicatif (requêtes/s, vu par HAProxy)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (rate(haproxy_server_http_responses_total{proxy=\"serveurs_applicatifs\"}[$__rate_interval]))",
          "legendFormat": "{{server}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(haproxy_frontend_http_requests_total{proxy=\"entree_http\"}[$__rate_interval]))",
          "legendFormat": "total (entrée)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Serveurs applicatifs (sonde /sante de HAProxy)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (server) (haproxy_server_status{proxy=\"serveurs_applicatifs\", state=\"UP\"})",
          "legendFormat": "{{server}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Machines joignables (node_exporter)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 9 },
      "targets": [
        { "refId": "A", "expr": "up{job=\"node\"}", "legendFormat": "{{machine}}", "instant": true, "range": false }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "value", "options": { "0": { "text": "ÉTEINTE", "color": "red" }, "1": { "text": "OK", "color": "green" } } } ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none",
        "orientation": "vertical"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Utilisation du processeur par machine (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (machine) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{machine}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Réponses du répartiteur par code HTTP (réponses/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(haproxy_frontend_http_responses_total{proxy=\"entree_http\"}[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Historique de disponibilité des machines (pannes V2, V4, V6…)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "up{job=\"node\"}", "legendFormat": "{{machine}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "value", "options": { "0": { "text": "éteinte", "color": "red" }, "1": { "text": "OK", "color": "green" } } } ]
        },
        "overrides": []
      },
      "options": { "showValue": "never", "mergeValues": true, "rowHeight": 0.8, "legend": { "showLegend": false } }
    }
  ]
}
